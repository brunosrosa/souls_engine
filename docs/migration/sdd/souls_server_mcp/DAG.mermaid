    classDef active fill:#2b6cb0,stroke:#3182ce,stroke-width:2px,color:#fff;
    classDef done fill:#2f855a,stroke:#38a169,stroke-width:2px,color:#fff;

    T1["TASK-001: McpSessionManager & Keep-Alive 15s<br/>(crates/souls_server/src/mcp/session.rs)"]:::done
